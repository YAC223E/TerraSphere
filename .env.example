# Copy to .env and fill in. Never commit .env.
# Cesium ion token for World Terrain / World Imagery / geocoder.
# Get one free at https://ion.cesium.com/tokens (Community plan).
# App works without it via ellipsoid fallback + open imagery/vectors.
VITE_CESIUM_ION_TOKEN=
VITE_DEFAULT_VIEW_LON=20
VITE_DEFAULT_VIEW_LAT=5
